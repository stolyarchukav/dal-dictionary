<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_layout_parent"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent">
    
    <ScrollView	android:id="@+id/root"
		android:layout_width="fill_parent"
    	android:layout_height="fill_parent">
		
		<LinearLayout android:id="@+id/main_layout"
			android:orientation="vertical" 
			android:layout_width="fill_parent"
			android:layout_height="wrap_content">
    
    		<TextView android:id="@+id/author"
    			android:layout_width="fill_parent" 
    			android:layout_height="wrap_content"
    			android:text="@string/author"
    			android:textSize="16sp"
    			android:textColor="#000000"
    			android:gravity="center_horizontal" />
    			
			<RelativeLayout
				android:layout_width="fill_parent"
				android:layout_height="wrap_content">

				<ImageView android:id="@+id/main_image"
					android:src="@drawable/portrait"
					android:layout_width="fill_parent"
					android:layout_height="wrap_content"
					android:layout_margin="5px"
					android:gravity="center_horizontal" />

				<Button android:id="@+id/switch_classic"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_alignParentEnd="true"
					android:layout_centerVertical="true"
					android:layout_marginEnd="10dp"
					android:text="@string/switch_to_classic"
					android:textSize="11sp"
					android:background="@drawable/selector_switch_mode"
					android:padding="4dp"
					android:alpha="0.7"
					android:visibility="gone" />

			</RelativeLayout>
   				
    		<TextView android:id="@+id/title"  
    			android:layout_width="fill_parent" 
    			android:layout_height="wrap_content"
    			android:text="@string/title"
    			android:textSize="18sp"
    			android:textStyle="bold"
    			android:textColor="#000000"
    			android:gravity="center_horizontal" />
    			
    		<LinearLayout android:orientation="horizontal" 
				android:layout_width="fill_parent"
				android:layout_height="wrap_content"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">
    			
    			<Button android:id="@+id/browse"
        			android:layout_width="fill_parent"
        			android:layout_height="wrap_content"
        			android:layout_weight="0.5"
			        android:background="@drawable/selector_dashboard_button"
        			android:drawableTop="@drawable/alphabet"
        			android:textSize="20sp"
        			android:textColor="#000000"
			        android:drawablePadding="-5dp"
        			android:text="@string/browse" />
        			
        		<Button android:id="@+id/search"
        			android:layout_width="fill_parent"
        			android:layout_height="wrap_content"
			        android:layout_weight="0.5"
			        android:background="@drawable/selector_dashboard_button"
        			android:drawableTop="@drawable/menu_search"
        			android:textSize="20sp"
        			android:textColor="#000000"
			        android:drawablePadding="-5dp"
        			android:text="@string/search" />

				<Button android:id="@+id/random_word"
					android:layout_width="fill_parent"
					android:layout_height="wrap_content"
					android:layout_weight="0.5"
					android:background="@drawable/selector_dashboard_button"
					android:drawableTop="@drawable/indeterminate_question_box_48px"
					android:textSize="20sp"
					android:textColor="#000000"
					android:drawablePadding="-5dp"
					android:text="@string/random_word" />
    			
    		</LinearLayout>

			<LinearLayout android:id="@+id/search_full_layout"
				android:orientation="vertical"
				android:layout_width="fill_parent"
				android:layout_height="wrap_content"
				android:background="@drawable/border_thin_black"
				android:layout_margin="3dp"
				android:layout_marginTop="10dp">

				<TextView
					android:layout_width="fill_parent"
					android:layout_height="wrap_content"
					android:text="@string/search_full"
					android:textSize="14sp"
					android:padding="5dp"
					/>

				<LinearLayout android:orientation="horizontal"
					android:layout_width="fill_parent"
					android:layout_height="wrap_content"
					android:padding="5dp">

					<EditText android:id="@+id/search_full_text"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_weight="0.9"
						android:hint="@string/search_string_empty"
					/>

					<Button android:id="@+id/search_full_button"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_weight="0.1"
						android:background="@drawable/selector_dashboard_button"
						android:drawableTop="@drawable/menu_search_full"
						android:textColor="#000000"
						android:textSize="11sp"
						android:text="@string/do_search" />

				</LinearLayout>

			</LinearLayout>

    		<Button android:id="@+id/rate_app" 
    			android:layout_width="fill_parent" 
    			android:layout_height="wrap_content"
    			android:text="@string/rate_app"
    			android:gravity="center_horizontal|center_vertical"
				android:layout_marginTop="30dp"
                android:textColor="@color/black"
				android:background="@null"
				android:textSize="12sp"
				android:drawableLeft="@drawable/button_rate"/>
    		
    		<Button android:id="@+id/moreAppsButton"
				android:layout_width="fill_parent" 
				android:layout_height="wrap_content"
				android:text="@string/main_more_apps" 
				android:gravity="center_horizontal|center_vertical" 
				android:layout_marginTop="10dp"
				android:layout_marginBottom="20dp"
                android:textColor="@color/black"
				android:textSize="12sp"
                android:background="@null" />

    	</LinearLayout>
    	
    </ScrollView>

</RelativeLayout>
